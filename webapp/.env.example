DATABASE_URL="postgresql://user:password@localhost:5432/family_command_center"

# NextAuth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Calendar + Gmail). See docs/GOOGLE_SETUP.md for how to
# create these in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Outbound email (invite emails, password resets). Any SMTP provider works
# -- Gmail, Resend, Postmark, SES, etc. See docs/EMAIL_SETUP.md. Leave
# blank to disable: invites fall back to a copy-paste link, and password
# reset shows a clear "not configured" message instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
